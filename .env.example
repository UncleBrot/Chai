# Rename this file to .env or configure these variables in Portainer's environment variables section

# --- Discord ---
Discord_Token=your_discord_bot_token_here
# Discord User ID of the bot owner (change this to your own Discord User ID if you host the bot)
OWNER_ID=762609713610620948

# --- Logging ---
# Channel ID in your dev server to log incoming DMs sent to the bot
BOT_LOGS_ID=your_bot_logs_channel_id_here
# Channel ID in your dev server to log all confessions across all servers
G_CONFESSION_LOG=your_global_confession_log_channel_id_here
# Channel ID in your dev server to log every !gif / /gif / !caption / /caption usage
img_log_id=your_log_channel_id_here

# --- Cloudflare R2 Storage ---
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-public-r2-domain.com
